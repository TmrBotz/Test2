# ─────────────────────────────────────────────
# Copy this to .env and fill values:
#   cp .env.example .env
# ─────────────────────────────────────────────

# REQUIRED: @BotFather se Telegram bot token
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# REQUIRED: Telegram channel ID ya username
CHANNEL_ID=@your_channel_username

# REQUIRED: MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# OPTIONAL
RSS_FEED_URL=https://uncutbaba.best/feed/
CHECK_INTERVAL=300
